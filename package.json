{
  "name": "wayfinder",
  "version": "0.1.0",
  "private": true,
  "description": "A local, conversational NAS operations assistant with a deny-by-default tool boundary.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "config:check": "tsx --env-file-if-exists=.env src/cli/config-check.ts",
    "dev": "tsx --env-file-if-exists=.env watch src/main.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check .",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/main.js",
    "test": "vitest run",
    "test:integration": "vitest run test/integration",
    "test:unit": "vitest run test/unit",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.99.2",
    "@earendil-works/pi-ai": "0.99.2",
    "@earendil-works/pi-session-backend-sqlite-node": "0.99.2",
    "@larksuiteoapi/node-sdk": "1.73.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "22.20.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
