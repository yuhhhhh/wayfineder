# Production runtime location. Do not replace these with the development defaults.
NODE_ENV=production
WAYFINDER_DATA_DIR=/var/lib/wayfinder
WAYFINDER_HEALTH_HOST=127.0.0.1
WAYFINDER_HEALTH_PORT=3030

# Enable both only after credentials and allowlists are complete.
WAYFINDER_LARK_ENABLED=false
WAYFINDER_LARK_APP_ID=
WAYFINDER_LARK_APP_SECRET=
WAYFINDER_USER_ROLES=
WAYFINDER_ALLOWED_CHAT_IDS=

WAYFINDER_MODEL_ENABLED=false
WAYFINDER_MODEL_PROVIDER=openai
WAYFINDER_MODEL_ID=
WAYFINDER_MODEL_API_KEY=
WAYFINDER_MODEL_TIMEOUT_MS=60000

WAYFINDER_WIFI_INTERFACE=wlp2s0
WAYFINDER_COMMAND_TIMEOUT_MS=5000
WAYFINDER_MAX_COMMAND_OUTPUT_BYTES=256000
WAYFINDER_MAX_CONCURRENT_COMMANDS=4
WAYFINDER_MAX_CONCURRENT_REQUESTS=4
WAYFINDER_MAX_QUEUED_REQUESTS=32
WAYFINDER_MAX_MESSAGE_CHARACTERS=4000
